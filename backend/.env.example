# ═══════════════════════════════════════════════════════════════════════
#  backend/.env.example — Easevent
#  Copier en .env pour le développement local.
#  En production sur Render, ces vars sont dans render.yaml et le
#  Dashboard (groupe "easevent-secrets").
# ═══════════════════════════════════════════════════════════════════════

# ── Django ──────────────────────────────────────────────────────────────
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Base de données (PostgreSQL local) ──────────────────────────────────
# Option A — URL complète (recommandé, utilisé par Render)
# DATABASE_URL=postgresql://easevent_user:password@localhost:5432/easevent_db

# Option B — Variables séparées
DB_NAME=easevent_db
DB_USER=easevent_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ─────────────────────────────────────────────────────────────────
# Séparés par des virgules si plusieurs origines
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# ── SendGrid (emails) ────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=noreply@easevent.app

# ── Cloudinary (stockage médias) ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
